# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=myapp_db
DB_PORT=5432
DB_EXTERNAL_PORT=54320
DB_HOST=db

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXTERNAL_PORT=6379
REDIS_CACHE_PREFIX=ankidemy

# Server Configuration
SERVER_PORT=8765
APP_ENV=production  # Default to production, override for dev
CORS_ALLOWED_ORIGIN=http://localhost:4500

# Client Configuration
CLIENT_PORT=4500
CLIENT_URL=http://localhost:4500
NEXT_PUBLIC_API_URL=http://localhost:8765

# PgAdmin Configuration
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5051

# Development Settings
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
NEXT_TURBO=true
TURBOPACK=true

# Enable Docker BuildKit features
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
